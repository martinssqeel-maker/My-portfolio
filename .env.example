# Server Configuration
PORT=5000
NODE_ENV=development

# Database URL (SQLite default for local dev, or PostgreSQL e.g. postgresql://user:password@localhost:5432/portfolio)
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Authentication (use a strong random string in production)
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"

# Initial Admin Credentials (used during seed)
ADMIN_EMAIL="martinssqeel@gmail.com"
ADMIN_INITIAL_PASSWORD="your-strong-admin-password-here"

# Allowed Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"
