# ==============================================================================
# Martins Moses Portfolio - Production Environment Variables
# Copy this file to .env for local testing or configure these in Vercel Project Settings
# ==============================================================================

# 1. Database Connection (PostgreSQL for Production / Vercel)
# Format for Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Format for Neon: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
# Format for Railway/Render: postgresql://postgres:[password]@[host]:[port]/[database]
# For offline local dev fallback: "file:./data/portfolio.db"
DATABASE_URL="postgresql://postgres:your_secure_db_password@your_host:5432/portfolio?sslmode=require"

# 2. Database SSL (Default: true in production for cloud PostgreSQL)
DATABASE_SSL="true"

# 3. Admin Authentication Security
# Generate a strong 64-character random string (e.g. openssl rand -hex 32)
JWT_SECRET="generate-a-strong-random-secret-key-for-production-min-32-chars"

# 4. Administrator Credentials
# Real email for Martins Moses
ADMIN_EMAIL="martinssqeel@gmail.com"
# Private admin password (used on initial seed or database setup)
ADMIN_PASSWORD="YourStrongPrivatePassword2026!"

# 5. Application Environment
NODE_ENV="production"
PORT=5000
